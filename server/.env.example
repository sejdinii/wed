# Kapar API — environment contract (see docs/PRODUCTION.md for the deploy checklist)

# Postgres connection. Local default matches docker-compose / scripts/setup-env.sh;
# Railway's managed Postgres injects its own.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kapar

PORT=3000

# 'production' disables the demo bot, dev auth codes in responses, and pretty logging.
NODE_ENV=development

# The compressed-timescale demo venue bot for OWNERLESS seed venues only.
# MUST be false in production.
DEMO_MODE=true

# Wave 7+: transactional email (auth codes). Absent = codes are logged only.
# RESEND_API_KEY=re_...
